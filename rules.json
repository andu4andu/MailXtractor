{
  "correlation_id": {
    "type": "auto",
    "source_priority": "none"
  },
  "date_of_input": {
    "type": "auto",
    "source_priority": "none"
  },
  "input_by": {
    "type": "empty",
    "source_priority": "none"
  },
  "customer": {
    "type": "keyword_match",
    "values": ["JMC", "Mazda", "VW PV", "Mercedes", "VW/ Scout", "Mitsubishi", "Volvo", "Daihatsu", "NIO", "XIAOMI", "Daimler", "Nissan", "AUDI", "FTBB", "Porsche", "BMW", "Ford", "Renault", "Chery", "GAC", "SAIC GM", "AGM", "SAIC VW", "GWM", "SGM", "Geely", "Seat", "Generic", "Skoda", "Great Wall", "Stellantis", "HMG", "Suzuki", "JLR", "Toyota", "GM", "VW"],
    "default": "Generic",
    "source_priority": "both"
  },
  "pdc": {
    "type": "keyword_match",
    "values": ["HUD", "DS"],
    "default": "n/a",
    "source_priority": "body"
  },
  "phase": {
    "type": "keyword_match",
    "values": ["RFI", "Acq", "Dev", "MP"],
    "default": "n/a",
    "source_priority": "both"
  },
  "project": {
    "type": "label",
    "labels": ["Project"],
    "default": "",
    "source_priority": "body"
  },
  "target_sop_year": {
    "type": "label",
    "labels": ["SOP"],
    "pattern": "\\d{4}",
    "default": "",
    "source_priority": "both"
  },
  "lifetime_volume": {
    "type": "sum_pattern",
    "year_anchored": true,
    "max_value": 2000000,
    "per_file": true,
    "default": "",
    "source_priority": "attachment"
  },
  "peak_annual_volume": {
    "type": "max_pattern",
    "pattern": "(?<=\\| )[1-9]\\d{1,2}(?:,\\d{3})+(?= \\|)",
    "fallback_pattern": "(?<=\\| )[1-9]\\d{4,6}(?= \\|)",
    "body_fallback_pattern": "\\b([1-9]\\d{4,5})\\b",
    "max_value": 2000000,
    "default": "n/a",
    "source_priority": "both"
  },
  "size": {
    "type": "label",
    "labels": ["Display diagonal (info)", "Display diagonal", "Display Diagonal"],
    "pattern": "\\d+\\.?\\d*(?!\\s*mm)",
    "regex_fallback": "\\b(?:[4-9]|1[0-9]|2[0-4])(?:\\.\\d+)?(?=\\s*(?:[\"\u201C\u201D\u2033]|inch(?:es)?))",
    "regex_fallback_body_first": true,
    "default": "",
    "source_priority": "both"
  },
  "resolution": {
    "type": "label",
    "labels": ["Display Resolution (info)", "Display Resolution", "Display resolution", "Resolution"],
    "pattern": "\\d{3,4}\\s*[xX*]\\s*(?:RGB\\s*[xX*]\\s*)?\\d{3,4}",
    "default": "",
    "source_priority": "both"
  },
  "dimensions": {
    "type": "label",
    "labels": ["Outline dimension", "Outline Dimension", "Outline dimensions", "Outline Dimensions", "Module size", "Module Size", "Active Area size", "Active Area Size"],
    "pattern": "[\\d.]+\\s*[xX*]\\s*[\\d.]+",
    "default": "",
    "source_priority": "both"
  },
  "polarizers": {
    "type": "label",
    "labels": ["Polariser Front", "Polarizer Front", "Front Polarizer", "Front Polariser", "Outer Polarizer", "Outer Polariser", "Polarizer Type", "Polariser Type", "Polarizer", "Polariser"],
    "pattern": "(?:Coating|Film)\\s*-\\s*[A-Z]+|Polarizer\\s+HC|Polariser\\s+HC|Standard|[A-Z]{2,}(?:-[A-Z]+)*",
    "default": "n/a",
    "source_priority": "attachment"
  },
  "lcf": {
    "type": "label",
    "labels": ["LCF", "Light Control Film"],
    "normalize_boolean": true,
    "default": "No",
    "source_priority": "attachment"
  },
  "display_technology": {
    "type": "keyword_match",
    "values": ["Touch Foil", "Cover Glass", "LTPS", "OLED Glass", "Oxide", "Segmented", "OGS Touch", "OLED Plastic", "a-Si", "OLED Hybrid", "OLED Under DisplayCam"],
    "default": "n/a",
    "source_priority": "both"
  },
  "screen_curve_flat": {
    "type": "label",
    "labels": ["Curvature", "Screen curvature", "Display curvature"],
    "pattern": "(?i)Flat|Curve[d]?",
    "default": "Flat",
    "source_priority": "both"
  },
  "illumination_cg": {
    "type": "keyword_match",
    "values": ["Matrix BLU", "SodaLime", "AluSi", "Edge BLU"],
    "aliases": {"Soda Lime": "SodaLime"},
    "default": "n/a",
    "source_priority": "attachment"
  },
  "touch": {
    "type": "label",
    "labels": ["Touch Type", "Touch technology", "Touch"],
    "normalize_boolean": true,
    "default": "No",
    "source_priority": "attachment"
  },
  "incell_outcell": {
    "type": "regex",
    "pattern": "\\b(in.?cell|out.?cell)\\b",
    "default": "",
    "source_priority": "both"
  },
  "display_type": {
    "type": "keyword_match",
    "values": ["Panel+CG+OB", "OGS Touch Glass", "Total Solution", "Cover Glass", "CG + Bonding only", "Touch Foil", "Segmented Display", "Display Module", "OLED Panel", "OLED TotalSolution", "Panel"],
    "default": "n/a",
    "source_priority": "both"
  },
  "bonding": {
    "type": "label",
    "labels": ["Bonding Type", "Bonding Technology", "Bonding"],
    "normalize_boolean": true,
    "default": "No",
    "source_priority": "attachment"
  },
  "status": {
    "type": "empty",
    "source_priority": "none"
  },
  "supplier_name": {
    "type": "email_domain",
    "fallback_type": "label",
    "labels": ["Supplier name", "Supplier Name", "Supplier", "Company Name", "Company", "供应商"],
    "pattern": "[A-Za-z][A-Za-z\\s,.()+\\-]{2,60}",
    "default": "Unknown",
    "source_priority": "attachment"
  },
  "org_cost": {
    "type": "label",
    "labels": ["Total C - Price", "Total B - Price", "TATAL-C", "TATAL-B"],
    "pattern": "\\d+(?:[.,]\\d+)?",
    "next_line": true,
    "default": "n/a",
    "source_priority": "attachment"
  },
  "org_currency": {
    "type": "label",
    "labels": ["Currency"],
    "pattern": "CNY|EUR|USD|RMB|GBP|JPY|HKD",
    "regex_fallback": "(?<=\\[)(CNY|EUR|USD|RMB|GBP|JPY|HKD)(?=\\])",
    "default": "",
    "source_priority": "both"
  },
  "price_in_pcis": {
    "type": "empty",
    "source_priority": "none"
  },
  "currency_in_pcis": {
    "type": "empty",
    "source_priority": "none"
  },
  "remarks": {
    "type": "label",
    "labels": ["Comments", "Remarks"],
    "collect_lines_pattern": "^\\d+\\)",
    "column_values": true,
    "default": "",
    "source_priority": "attachment"
  },
  "nre_cost": {
    "type": "label",
    "labels": ["Total Tooling Costs", "NRECost", "NRE Cost", "Development Cost", "研发费用"],
    "pattern": "\\d{1,3}(?:,\\d{3})+(?:\\.\\d+)?|\\d{4,}(?:\\.\\d+)?",
    "next_line": true,
    "default": "",
    "source_priority": "attachment"
  },
  "conti_pn": {
    "type": "label",
    "labels": ["Part no.", "Part no:"],
    "pattern": "[A-Z]{2,4}\\d{8,12}",
    "default": "",
    "source_priority": "attachment"
  },
  "supplyon_no": {
    "type": "regex",
    "pattern": "\\b\\d{10}\\b",
    "default": "",
    "source_priority": "both"
  },
  "local_dimming": {
    "type": "label",
    "labels": ["Light Control Characteristic [Y/N]", "Light Control Characteristic", "Local Dimming", "Matrix Backlight"],
    "normalize_boolean": true,
    "default": "No",
    "source_priority": "both"
  },
  "candela": {
    "type": "label",
    "labels": ["Luminance"],
    "pattern": "\\d[\\d,.]*(?:\\s*(?:cd/m[²2]|nits?))?",
    "default": "",
    "source_priority": "both"
  },
  "no_of_drivers": {
    "type": "label",
    "labels": ["LED Driver IC", "No of drivers", "Number of drivers"],
    "pattern": "\\d+\\s*pcs?",
    "default": "",
    "source_priority": "attachment"
  },
  "blu_cas_sta": {
    "type": "keyword_match",
    "values": ["STA", "NoCover", "CAS"],
    "default": "n/a",
    "source_priority": "attachment"
  },
  "active_area": {
    "type": "label",
    "labels": ["Active Area size", "Active Area Size", "Active area", "Active dimension", "Active Dimension", "Active dimensions", "Active Dimensions"],
    "pattern": "[\\d.]+\\s*[xX*]\\s*[\\d.]+",
    "default": "",
    "source_priority": "both"
  },
  "overall_confidence": {
    "type": "empty",
    "source_priority": "none"
  },
  "review_type": {
    "type": "empty",
    "source_priority": "none"
  },
  "promoted_at": {
    "type": "empty",
    "source_priority": "none"
  },
  "promoted_by": {
    "type": "empty",
    "source_priority": "none"
  }
}
